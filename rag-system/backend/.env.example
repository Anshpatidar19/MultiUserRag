# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# --- Pinecone ---
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=rag-multitenant
PINECONE_ENVIRONMENT=us-east-1

# --- Gemini (get a key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# --- Generation mode: "agentic" or "gated" (see app/llm/client.py) ---
GENERATION_MODE=agentic
CONFIDENCE_GATE_THRESHOLD=0.35

# --- Langfuse (optional in dev; tracing no-ops if blank) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]